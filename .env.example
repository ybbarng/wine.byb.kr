# 이 파일은 "어떤 키가 필요한가"만 알려주는 견본이다.
# 실제 값은 각 환경의 .env 에만 두고 저장소에는 커밋하지 않는다(.gitignore 처리됨).
# 운영 서버(byb.kr)의 포트 같은 배포 환경 종속 값은 그 서버의 .env 에서만 관리한다.

# 앱이 리스닝할 포트. 개발 기본값은 3000.
# 운영 서버는 자체 .env 에서 별도 포트를 지정한다.
PORT=3000

# 관리자(편집 권한) 비밀번호. 실제 값은 서버 .env 에만.
ADMIN_PASSWORD=change-me

# 세션 쿠키 서명용 시크릿. 충분히 긴 임의 문자열로.
SESSION_SECRET=change-me
