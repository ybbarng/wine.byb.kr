# 이 파일은 "어떤 키가 필요한가"만 알려주는 견본이다.
# 실제 값은 각 환경의 .env 에만 두고 저장소에는 커밋하지 않는다(.gitignore 처리됨).
# 운영 서버(byb.kr)의 포트 같은 배포 환경 종속 값은 그 서버의 .env 에서만 관리한다.

# 앱이 리스닝할 포트. 개발 기본값은 3000.
# 운영 서버는 자체 .env 에서 별도 포트를 지정한다.
PORT=3000

# SQLite(libsql) 파일 경로. Prisma CLI(db push/generate)와 런타임 어댑터가 함께 쓴다.
# 데이터는 서버의 data/wine.db 에만 있고 저장소에는 커밋하지 않는다(.gitignore 처리됨).
DATABASE_URL="file:./data/wine.db"

# 관리자(편집 권한) 비밀번호. 실제 값은 서버 .env 에만.
# 편집 요청은 x-admin-password 헤더로 이 값을 보내 서버에서 확인한다(세션 쿠키는 두지 않음).
ADMIN_PASSWORD=change-me
